{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "jsx": "react-jsx",
    // Ring's built modules use extensionless paths, which only bundler resolution accepts.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": []
  },
  "include": ["src"]
}
