{
  "name": "@malverdesoftware/ui",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "description": "The shared look of MalverdeSoftware apps: Ring UI setup, stylesheets, the page frame and safe confirmation dialogs. See docs/specs/SPEC-ui.md.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./controls": {
      "types": "./dist/controls.d.ts",
      "default": "./dist/controls.js"
    },
    "./base.css": "./css/base.css",
    "./accent-green.css": "./css/accent-green.css"
  },
  "bin": {
    "malverdesoftware-ui-check": "./scripts/check-app.mjs"
  },
  "files": [
    "dist",
    "css",
    "scripts",
    "LICENSE",
    "NOTICE"
  ],
  "peerDependencies": {
    "@fontsource-variable/mona-sans": "5.3.0",
    "@jetbrains/icons": "5.24.0",
    "@jetbrains/ring-ui-built": "7.0.133",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@fontsource-variable/mona-sans": "5.3.0",
    "@jetbrains/icons": "5.24.0",
    "@jetbrains/ring-ui-built": "7.0.133",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jsdom": "25.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "vitest": "4.1.11"
  },
  "scripts": {
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MalverdeSoftware/malverdesoftware.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/MalverdeSoftware/malverdesoftware/tree/main/packages/ui#readme",
  "author": "Valentín Quiroz de la Sierra",
  "contributors": [
    "Marissa Ledesma"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
