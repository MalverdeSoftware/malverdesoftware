{
  "name": "@malverdesoftware/relay",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "description": "Ciphertext-only session relay for MalverdeSoftware apps: a portable Fetch API handler and storage adapters.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "malverdesoftware-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "malverdesoftware-source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "sql",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MalverdeSoftware/malverdesoftware.git",
    "directory": "packages/relay"
  },
  "homepage": "https://github.com/MalverdeSoftware/malverdesoftware/tree/main/packages/relay#readme",
  "author": "Valentín Quiroz de la Sierra",
  "contributors": [
    "Marissa Ledesma"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
